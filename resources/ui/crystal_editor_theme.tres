[gd_resource type="Theme" load_steps=15 format=3]

; The crystal editor's chrome. Every colour here is deliberately in the same family as
; CrystalVisuals so the panel does not fight the lattice drawn between the panels.
;
; Edit this in Godot: open it, and the Theme editor opens in the bottom panel with a live
; preview of every control. Hand-authored art goes in later as StyleBoxTexture (9-patch)
; swapped for these StyleBoxFlats -- the theme item names below do not change.

; ── panels ───────────────────────────────────────────────────────────────────────

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 12.0
content_margin_top = 12.0
content_margin_right = 12.0
content_margin_bottom = 12.0
bg_color = Color(0.086, 0.106, 0.149, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.157, 0.196, 0.29, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

; ── buttons ──────────────────────────────────────────────────────────────────────
; Five states, five styleboxes. Dropping "focus" is the classic mistake -- keyboard
; navigation goes invisible and nothing looks broken until someone tabs.

