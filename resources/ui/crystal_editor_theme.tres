[resource]
default_font_size = 14
Button/colors/font_color = Color(0.875, 0.902, 0.914, 1)
Button/colors/font_disabled_color = Color(0.404, 0.443, 0.514, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/styles/disabled = SubResource("StyleBoxFlat_btn_disabled")
Button/styles/focus = SubResource("StyleBoxFlat_btn_focus")
Button/styles/hover = SubResource("StyleBoxFlat_btn_hover")
Button/styles/normal = SubResource("StyleBoxFlat_btn_normal")
Button/styles/pressed = SubResource("StyleBoxFlat_btn_pressed")
CheckBox/colors/font_color = Color(0.804, 0.843, 0.867, 1)
CheckBox/colors/font_hover_color = Color(1, 1, 1, 1)
CrystalSwatch/base_type = &"Button"
CrystalSwatch/colors/font_color = Color(0.875, 0.902, 0.914, 1)
CrystalSwatch/colors/font_hover_color = Color(1, 1, 1, 1)
CrystalSwatch/colors/font_pressed_color = Color(1, 1, 1, 1)
CrystalSwatch/styles/focus = SubResource("StyleBoxFlat_btn_focus")
CrystalSwatch/styles/hover = SubResource("StyleBoxFlat_swatch_hover")
CrystalSwatch/styles/normal = SubResource("StyleBoxFlat_swatch_normal")
CrystalSwatch/styles/pressed = SubResource("StyleBoxFlat_swatch_pressed")
CrystalSwatchSelected/base_type = &"Button"
CrystalSwatchSelected/styles/focus = SubResource("StyleBoxFlat_btn_focus")
CrystalSwatchSelected/styles/hover = SubResource("StyleBoxFlat_swatch_sel_hover")
CrystalSwatchSelected/styles/normal = SubResource("StyleBoxFlat_swatch_sel_normal")
CrystalSwatchSelected/styles/pressed = SubResource("StyleBoxFlat_swatch_sel_normal")
HSeparator/constants/separation = 10
HSeparator/styles/separator = SubResource("StyleBoxLine_separator")
Label/colors/font_color = Color(0.875, 0.902, 0.914, 1)
LineEdit/colors/caret_color = Color(0.345, 0.627, 1, 1)
LineEdit/colors/font_color = Color(0.875, 0.902, 0.914, 1)
LineEdit/colors/font_placeholder_color = Color(0.404, 0.443, 0.514, 1)
LineEdit/styles/focus = SubResource("StyleBoxFlat_line_focus")
LineEdit/styles/normal = SubResource("StyleBoxFlat_line_normal")
Panel/styles/panel = SubResource("StyleBoxFlat_panel")
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")
VBoxContainer/constants/separation = 6
