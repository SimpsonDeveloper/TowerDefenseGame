; ── crystal swatches ─────────────────────────────────────────────────────────────
; A THEME TYPE VARIATION: a custom name whose base_type is Button, so these six style
; independently of every other Button without a subclass. The per-kind colour cannot live
; here (a theme is static, the roster is not) -- BuildPalette duplicates these and paints
; them from CrystalVisuals.Tint. What the theme fixes is the shape, padding and states.

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_swatch_normal"]
content_margin_left = 10.0
content_margin_top = 7.0
content_margin_right = 10.0
content_margin_bottom = 7.0
bg_color = Color(0.11, 0.137, 0.2, 1)
border_width_left = 4
border_color = Color(1, 1, 1, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

